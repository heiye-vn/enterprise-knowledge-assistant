# 本地开发配置；使用简单账号，服务只监听本机。
KH_POSTGRES_USER=postgres
KH_POSTGRES_PASSWORD=12345678
KH_POSTGRES_DB=knowledge_assistant
KH_DATABASE_URL=postgresql+psycopg://postgres:12345678@127.0.0.1:5544/knowledge_assistant
KH_REDIS_URL=redis://127.0.0.1:6384/0
KH_S3_ENDPOINT=http://127.0.0.1:9014
KH_S3_ACCESS_KEY=admin
KH_S3_SECRET_KEY=12345678
KH_S3_BUCKET=knowledge-assistant
KH_S3_REGION=us-east-1
KH_NEO4J_URI=bolt://127.0.0.1:7694
KH_NEO4J_USER=neo4j
KH_NEO4J_PASSWORD=12345678
KH_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
# 导入任务：原件已保存不等于解析/向量索引已完成。
KH_UPLOAD_MAX_BYTES=20971520
KH_ORIGINAL_PREFIX=originals
KH_DISPATCH_INTERVAL=10
KH_JOB_LEASE_SECONDS=120
KH_IMPORT_MAX_ATTEMPTS=3
# 知识图谱：按当前已发布原文分批抽取，达到上限时页面明确提示。
KH_GRAPH_NAMESPACE=enterprise-knowledge-assistant
KH_GRAPH_BATCH_SIZE=5
KH_GRAPH_MAX_UNITS=100
# MinerU 官方 v4 API；仅在私有 .env 中填写 Token。
KH_MINERU_API_TOKEN=
KH_MINERU_MODEL=vlm
KH_MINERU_LANGUAGE=ch
# 推理、向量、重排模型
QWEN_LLM_MODEL=qwen3.8-max-0902
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIMENSION=1024
QWEN_RERANK_MODEL=qwen3.7-text-rerank
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 三方中转站模型
MONKEY_LLM_MODEL=gpt-6.1-sol
MONKEY_BASE_URL=https://api.monkeycoding.club
MONKEY_API_KEY=sk-xxx

# 回答模型提供方：qwen 或 monkey；向量和重排始终使用 QWEN_*。
KH_LLM_PROVIDER=qwen

# 千问与 MinerU 客户端默认直接连接，不继承系统/环境代理；需要代理时显式设为 true。
KH_MODEL_TRUST_ENV=false
KH_MODEL_TIMEOUT_SECONDS=60
# 三方回答模型可独立设置；省略时沿用 KH_MODEL_TRUST_ENV。
# 本机三方服务需要系统代理时设为 true；容器还需配置其可访问的代理地址。
KH_MONKEY_MODEL_TRUST_ENV=true
# Tavily：仅显式开启联网且属于公共问题时调用一次。
TAVILY_API_KEY=
KH_TAVILY_TRUST_ENV=true
KH_TAVILY_TIMEOUT_SECONDS=20

# LangSmith：默认仅记录元数据，下方正文开关可按需开启。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-knowledge-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
KH_LANGSMITH_TRUST_ENV=true
# 调试时记录问题、模型输入、检索片段与回答；已知密钥仍脱敏。
KH_LANGSMITH_RECORD_CONTENT=false
