# 本地开发示例；复制为 .env 并替换三个密码。只监听本机，不复用其他项目凭证。
KH_POSTGRES_USER=knowledge
KH_POSTGRES_PASSWORD=local-development-password
KH_POSTGRES_DB=knowledge_assistant
KH_DATABASE_URL=postgresql+psycopg://knowledge:local-development-password@127.0.0.1:5544/knowledge_assistant
KH_REDIS_URL=redis://127.0.0.1:6384/0
KH_S3_ENDPOINT=http://127.0.0.1:9014
KH_S3_ACCESS_KEY=knowledge-local
KH_S3_SECRET_KEY=local-development-storage-password
KH_S3_BUCKET=knowledge-assistant
KH_S3_REGION=us-east-1
KH_NEO4J_URI=bolt://127.0.0.1:7694
KH_NEO4J_USER=neo4j
KH_NEO4J_PASSWORD=local-development-graph-password
KH_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174"]
